<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="product1" class="com.decipherzone.beanwiring.Product" >
        <constructor-arg  value="111" />
        <constructor-arg  value="IPhone16" />
        <constructor-arg  value="99999.00" />
    </bean>

    <bean id="product2" class="com.decipherzone.beanwiring.Product" >
        <constructor-arg  value="132" />
        <constructor-arg  value="IPhone16 pro" />
        <constructor-arg  value="120000.00" />
    </bean>
    <bean id="information" class="com.decipherzone.beanwiring.Information" >

    </bean>

    <bean id="cart" class="com.decipherzone.beanwiring.Cart" autowire="byName"/>
</beans>